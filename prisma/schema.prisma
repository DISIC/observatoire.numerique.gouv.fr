// ids sur 24 caractères hexa comme les ObjectId Mongo (conservés à la migration),
// préfixés par l'horodatage pour rester croissants dans l'ordre de création
datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_ADDON_URI")
}

generator client {
  provider = "prisma-client-js"
}

enum IndicatorSlug {
  online
  satisfaction
  handicap
  dlnuf
  usage
  simplicity
  help_reachable
  help_efficient
  help_used
  uptime
  performance
  auth
}

enum IndicatorColor {
  blue
  red
  orange
  yellow
  green
  gray
}

model OldProcedure {
  id                                           String   @id @default(dbgenerated("lpad(to_hex((extract(epoch FROM clock_timestamp()) * 1000000)::bigint), 13, '0') || substr(md5(random()::text), 1, 11)"))
  xwiki_id                                     String
  xwiki_edition                                String
  title                                        String
  statutDemat                                  String?
  ministere                                    String?
  groupes                                      String?
  direction                                    String?
  dateMiseEnLigne_display                      String?
  dateMiseEnLigne_value                        String?
  volumetrie_display                           String?
  volumetrie_value                             Int?
  pourcentageRecoursVoieDematerialisee_display String?
  pourcentageRecoursVoieDematerialisee_value   Int?
  franceConnect_value                          String?
  franceConnect_display                        String?
  adapteMobile_display                         String?
  adapteMobile_value                           String?
  qualiteSupport                               String?
  avisCount_display                            Int?
  avisCount_value                              Int?
  satisfactionIndex_display                    String?
  satisfactionIndex_value                      Float?
  urlScore_display                             String?
  urlScore_value                               String?
  urlDemarche                                  String?
  ditesLeNousUneFois_display                   String?
  ditesLeNousUneFois_value                     Int?
  categoriesPublics_display                    String?
  categoriesPublics_value                      String[]
  rgaaCompliancyLevel_display                  String?
  rgaaCompliancyLevel_value                    Float?
  accessibilityScore_display                   String?
  accessibilityScore_value                     String?
  jdma_start_date                              String?
  jdma_end_date                                String?

  @@index([xwiki_edition, ministere])
}

model Edition {
  id         String      @id @default(dbgenerated("lpad(to_hex((extract(epoch FROM clock_timestamp()) * 1000000)::bigint), 13, '0') || substr(md5(random()::text), 1, 11)"))
  name       String      @unique
  start_date DateTime
  end_date   DateTime
  created_at DateTime
  version    Int         @default(2)
  Procedure  Procedure[]
}

model Procedure {
  id                     String   @id @default(dbgenerated("lpad(to_hex((extract(epoch FROM clock_timestamp()) * 1000000)::bigint), 13, '0') || substr(md5(random()::text), 1, 11)"))
  grist_identifier       Int?
  jdma_identifier        Int?
  title                  String
  title_normalized       String
  ministere              String
  administration         String
  administration_central String?
  sousorg                String
  volume                 Int?
  fields                 Field[]
  noJdma                 Boolean
  edition                Edition? @relation(fields: [editionId], references: [id])
  editionId              String?

  @@index([editionId])
  @@index([editionId, title_normalized])
  @@index([editionId, administration])
  @@index([editionId, administration_central])
  @@index([editionId, ministere])
}

model Field {
  id           String         @id @default(dbgenerated("lpad(to_hex((extract(epoch FROM clock_timestamp()) * 1000000)::bigint), 13, '0') || substr(md5(random()::text), 1, 11)"))
  slug         IndicatorSlug
  label        String
  value        String?
  color        IndicatorColor
  noBackground Boolean?
  goalReached  Boolean?
  procedure    Procedure      @relation(fields: [procedureId], references: [id])
  procedureId  String        

  @@index([procedureId, slug, goalReached, color])
}
