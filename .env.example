# GRIST
GRIST_DOC_URL=xxx
GRIST_API_KEY=xxx
GRIST_TABLE_EDITION=xxx
GRIST_TABLE_PROCEDURES=xxx

# MATOMO
NEXT_PUBLIC_MATOMO_URL="xxx"
NEXT_PUBLIC_MATOMO_SITE_ID="xxx"

# HOTJAR
NEXT_PUBLIC_HOTJAR_SITE_ID=
NEXT_PUBLIC_HOTJAR_VERSION=

# AUTH
NEXT_PUBLIC_JWT_COOKIE_NAME=payload-token
JWT_SECRET=mysecret
JWT_SIGNING_KEY=mykey
JWT_ENCRYPTION_KEY=myencryptionkey
JWT_ENCRYPTION_ALGORITHM=HS512
JWT_EXPIRATION_TIME=2592000 # 1 month in seconds

# Maildev
NODEMAILER_HOST=localhost
NODEMAILER_PORT=1025

# S3
CELLAR_ADDON_HOST=host
CELLAR_ADDON_KEY_ID=key-id
CELLAR_ADDON_KEY_SECRET=key-secret
S3_BUCKET_NAME=bucket

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PostgreSQL (add-on Clever Cloud en prod) : Prisma dans le schéma « public », Payload dans « payload »
POSTGRESQL_ADDON_URI="postgresql://user:password@127.0.0.1:5432/observatoire"

# Connexions PostgreSQL par instance (offre « dev » Clever Cloud : 5 au total)
# PRISMA_CONNECTION_LIMIT=5
# PAYLOAD_DB_POOL_MAX=5

# Optionnel : base Payload distincte (sinon POSTGRESQL_ADDON_URI)
# DATABASE_URI=

# Uniquement pour la migration des données depuis l'ancien MongoDB (src/scripts/migrate-mongo-to-postgres.ts)
# MONGO_SOURCE_URI="mongodb://user:password@127.0.0.1:27018/?authSource=admin"
# MONGO_SOURCE_PRISMA_DB=observatoire
# MONGO_SOURCE_PAYLOAD_DB=observatoire-payload
PAYLOAD_SECRET=dev
